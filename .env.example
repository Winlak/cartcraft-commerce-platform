# PostgreSQL / Redis
POSTGRES_DB=cartcraft
POSTGRES_USER=cartcraft
POSTGRES_PASSWORD=cartcraft
DATABASE_URL="postgresql://cartcraft:cartcraft@localhost:5432/cartcraft?schema=public"
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
JWT_SECRET="change-me-in-local-env-to-a-long-random-string"
JWT_EXPIRES_IN="2h"
MOCK_PAYMENT_WEBHOOK_SECRET="local-webhook-secret"
CORS_ORIGIN="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
